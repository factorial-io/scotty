{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "svelte-kit sync && vitest",
		"lint": "prettier --check . && eslint .",
		"lint+fix": "prettier --check --write . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/crypto-js": "^4.2.2",
		"@types/eslint": "^9.6.1",
		"daisyui": "^5.7.50",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.0"
	},
	"type": "module",
	"dependencies": {
		"@iconify-icons/ph": "^2.0.0",
		"@iconify/svelte": "^5.2.4",
		"@tailwindcss/typography": "^0.5.20",
		"crypto-js": "^4.2.0"
	},
	"overrides": {
		"brace-expansion": "^5.0.12",
		"cookie": "^2.0.0",
		"devalue": "^6.0.0",
		"flatted": "^3.4.2",
		"nanoid": "^3.3.20",
		"postcss": "^8.5.32",
		"source-map-js": "^1.2.2",
		"uuid": "^14.0.0",
		"yaml": "^2.8.4"
	}
}
