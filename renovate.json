{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "cargo": {
    "rangeStrategy": "update-lockfile"
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "rangeStrategy": "update-lockfile",
      "enabled": true
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "addLabels": [
        "rust"
      ]
    },
    {
      "groupName": "utoipa packages",
      "matchPackageNames": [
        "/^utoipa[-_]?/"
      ]
    },
    {
      "matchPackageNames": [
        "capnp",
        "capnpc"
      ],
      "groupName": "capnp packages"
    },
    {
      "groupName": "futures packages",
      "matchPackageNames": [
        "/^futures[-_]?/"
      ]
    },
    {
      "description": "Group OpenTelemetry crates so they bump together (opentelemetry + sdk + otlp + appender + tracing-opentelemetry release in lockstep and depend on matching versions of each other)",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry_sdk",
        "opentelemetry-otlp",
        "opentelemetry-appender-tracing",
        "tracing-opentelemetry",
        "init-tracing-opentelemetry",
      ],
      "groupName": "opentelemetry"
    },
    {
      "groupName": "gRPC-related packages",
      "matchPackageNames": [
        "/^prost[-_]?/",
        "/^tonic[-_]?/"
      ]
    },
    {
      "groupName": "rusoto packages",
      "matchPackageNames": [
        "/^rusoto[-_]?/"
      ]
    },
    {
      "groupName": "serde packages",
      "matchPackageNames": [
        "/^serde[-_]?/"
      ]
    },
    {
      "groupName": "tokio packages",
      "matchPackageNames": [
        "/^tokio[-_]?/"
      ]
    },
    {
      "groupName": "tracing packages",
      "matchPackageNames": [
        "/^tracing[-_]?/",
        "!tracing-opentelemetry"
      ]
    },
    {
      "matchPackageNames": [
        "hyper-rustls",
        "rustls",
        "rustls-native-certs",
        "tokio-rustls",
        "webpki",
        "webpki-roots"
      ],
      "groupName": "rustls packages"
    },
    {
      "matchManagers": [
        "bun"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "gitLabIgnoreApprovals": true,
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Bun dependencies auto-merge (patch)"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "gitLabIgnoreApprovals": true,
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Rust dependencies auto-merge (patch)"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "docker"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ],
      "groupName": "Lagoon Base images",
      "rebaseWhen": "behind-base-branch",
      "matchPackageNames": [
        "/^uselagoon//"
      ]
    }
  ],
  "extends": [
    "config:recommended"
  ]
}
