{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "cargo": {
    "rangeStrategy": "update-lockfile"
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "rangeStrategy": "update-lockfile",
      "enabled": true
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "addLabels": [
        "rust"
      ]
    },
    {
      "groupName": "utoipa packages",
      "matchPackageNames": [
        "/^utoipa[-_]?/"
      ]
    },
    {
      "matchPackageNames": [
        "capnp",
        "capnpc"
      ],
      "groupName": "capnp packages"
    },
    {
      "groupName": "futures packages",
      "matchPackageNames": [
        "/^futures[-_]?/"
      ]
    },
    {
      "groupName": "gRPC-related packages",
      "matchPackageNames": [
        "/^prost[-_]?/",
        "/^tonic[-_]?/"
      ]
    },
    {
      "groupName": "rusoto packages",
      "matchPackageNames": [
        "/^rusoto[-_]?/"
      ]
    },
    {
      "groupName": "serde packages",
      "matchPackageNames": [
        "/^serde[-_]?/"
      ]
    },
    {
      "groupName": "tokio packages",
      "matchPackageNames": [
        "/^tokio[-_]?/"
      ]
    },
    {
      "groupName": "tracing packages",
      "matchPackageNames": [
        "/^tracing[-_]?/",
        "!/opentelemetry/"
      ]
    },
    {
      "matchPackageNames": [
        "hyper-rustls",
        "rustls",
        "rustls-native-certs",
        "tokio-rustls",
        "webpki",
        "webpki-roots"
      ],
      "groupName": "rustls packages"
    },
    {
      "matchManagers": [
        "bun"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "gitLabIgnoreApprovals": true,
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Bun dependencies auto-merge (patch)"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "gitLabIgnoreApprovals": true,
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Rust dependencies auto-merge (patch)"
    },
    {
      "description": "Group all OpenTelemetry crates into one PR. opentelemetry, opentelemetry_sdk, opentelemetry-otlp, tracing-opentelemetry and davidB's init-/axum-tracing-opentelemetry must agree on the same opentelemetry version, so bumping them separately leaves duplicate opentelemetry versions in the lockfile. This rule is placed after the patch auto-merge group so that its groupName wins for patch updates too.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/opentelemetry/"
      ],
      "groupName": "opentelemetry"
    },
    {
      "description": "Group the Svelte/SvelteKit toolchain into one PR. @sveltejs/kit, its adapters, vite-plugin-svelte, svelte and the svelte tooling have tight peer-dependency ranges, so separate PRs (e.g. kit and adapter-static majors) fail CI on their own and compete with each other. Placed after the bun patch auto-merge group so that its groupName wins for patch updates too.",
      "matchManagers": [
        "bun"
      ],
      "matchPackageNames": [
        "@sveltejs/**",
        "svelte",
        "svelte-check",
        "prettier-plugin-svelte",
        "eslint-plugin-svelte"
      ],
      "groupName": "sveltekit"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "docker"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ],
      "groupName": "Lagoon Base images",
      "rebaseWhen": "behind-base-branch",
      "matchPackageNames": [
        "/^uselagoon//"
      ]
    }
  ],
  "extends": [
    "config:recommended"
  ]
}
